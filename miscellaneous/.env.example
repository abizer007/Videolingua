# VidioLingua environment reference
# Copy to backend/.env and fill in local paths/secrets.

# Backend
API_BASE_URL=http://localhost:8000
JOBS_DIR=D:/Vidiolingua/jobs

# Stage-specific Python runtimes
VIDIOLINGUA_API_PYTHON=D:/Vidiolingua/.venv_api/Scripts/python.exe
VIDIOLINGUA_ASR_PYTHON=D:/Vidiolingua/.venv_asr/Scripts/python.exe
VIDIOLINGUA_TTS_PYTHON=D:/Vidiolingua/.venv_tts/Scripts/python.exe
VIDIOLINGUA_BGM_PYTHON=D:/Vidiolingua/.venv_bgm/Scripts/python.exe
VIDIOLINGUA_MUSETALK_PYTHON=D:/Vidiolingua/.venv_musetalk/Scripts/python.exe
VIDIOLINGUA_GFP_GAN_PYTHON=D:/Vidiolingua/.venv_gfpgan/Scripts/python.exe

# ASR: WhisperX + PyAnnote
VIDIOLINGUA_WHISPER_MODEL=base
VIDIOLINGUA_SOURCE_LANGUAGE=
HUGGINGFACE_TOKEN=
HF_HOME=D:/Vidiolingua/.hf_cache

# Speaker analysis / diarization.
# Store real tokens only in backend/.env. Do not expose them to the frontend.
VIDIOLINGUA_ENABLE_SPEAKER_DIARIZATION=true
VIDIOLINGUA_DIARIZATION_BACKEND=pyannote
VIDIOLINGUA_PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
VIDIOLINGUA_PYANNOTE_TOKEN=
VIDIOLINGUA_PYANNOTE_DEVICE=auto
VIDIOLINGUA_PYANNOTE_MIN_SPEAKERS=
VIDIOLINGUA_PYANNOTE_MAX_SPEAKERS=
VIDIOLINGUA_FAIL_ON_DIARIZATION_ERROR=false
VIDIOLINGUA_AUTO_EXTRACT_SPEAKER_REFERENCES=true
VIDIOLINGUA_AUTO_USE_EXTRACTED_REFERENCES_FOR_XTTS=false
VIDIOLINGUA_ALLOW_SINGLE_REFERENCE_FOR_ALL_SPEAKERS=false
VIDIOLINGUA_SARVAM_VOICE_PROFILE_CONFIG=config/sarvam_voice_profiles.example.json
VIDIOLINGUA_SARVAM_SPEAKER_OVERRIDES_JSON=

# Translation: router policy.
# Supported IndicTrans2 pairs use IndicTrans2 first in production, even if this
# legacy value is google for unsupported pairs such as en->fr.
VIDIOLINGUA_TRANSLATION_ENGINE=google
VIDIOLINGUA_TRANSLATION_ALLOW_GOOGLE_FALLBACK=false
VIDIOLINGUA_ALLOW_LLM_TRANSLATION_FALLBACK=false
VIDIOLINGUA_ALLOW_DEEP_TRANSLATOR_FALLBACK=false
VIDIOLINGUA_ALLOW_LLM_POST_EDIT=false
VIDIOLINGUA_INDICTRANS2_ENABLED=true
VIDIOLINGUA_INDICTRANS2_PYTHON=D:/Vidiolingua/.venv_indictrans2/Scripts/python.exe
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# TTS: XTTS remains primary for XTTS-supported languages. Sarvam is the
# managed Indian-language TTS backend; it is not exact voice cloning.
VIDIOLINGUA_VOICE_ENGINE=auto
VIDIOLINGUA_TTS_ENGINE=xtts
VOICE_ENGINE=xtts
VOICE_CLONING_REQUIRED=true
VIDIOLINGUA_CLONING_REQUIRED=true
VIDIOLINGUA_REQUIRE_VOICE_CLONE=true
ALLOW_GENERIC_TTS_FALLBACK=false
VIDIOLINGUA_ALLOW_GENERIC_TTS_FALLBACK=false
VIDIOLINGUA_ALLOW_XTTS_TO_INDICF5_FALLBACK=true
VIDIOLINGUA_INDIC_VOICE_BACKEND=sarvam
VIDIOLINGUA_ENABLE_SARVAM=true
SARVAM_API_KEY=
VIDIOLINGUA_SARVAM_MODEL=bulbul:v3
VIDIOLINGUA_SARVAM_SPEAKER=shubh
VIDIOLINGUA_SARVAM_PACE=1.0
VIDIOLINGUA_SARVAM_TEMPERATURE=0.45
VIDIOLINGUA_SARVAM_SAMPLE_RATE=24000
VIDIOLINGUA_SARVAM_OUTPUT_CODEC=wav
VIDIOLINGUA_SARVAM_TIMEOUT_SECONDS=120
VIDIOLINGUA_ENABLE_INDICF5=false
VIDIOLINGUA_INDICF5_ENABLED=false
VIDIOLINGUA_INDICF5_EXECUTION_MODE=local_disabled
VIDIOLINGUA_INDICF5_PYTHON=D:/Vidiolingua/.venv_indicf5/Scripts/python.exe
VIDIOLINGUA_REFERENCE_TEXT=
VIDIOLINGUA_REFERENCE_TEXT_PATH=
VIDIOLINGUA_FORCE_VOICE_REGENERATE=true
VIDIOLINGUA_TARGET_LANGUAGES=fr

# Local XTTS v2 model directory.
# Must contain config.json, model.pth or another .pth checkpoint, and vocab.json or tokenizer.json.
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
VIDIOLINGUA_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
VIDIOLINGUA_XTTS_MODEL_PATH=
SPEAKER_REFERENCE_AUDIO=
VIDIOLINGUA_VOICE_SAMPLE=
XTTS_LANGUAGE=en
XTTS_DEVICE=auto
XTTS_MODEL_LOAD_TIMEOUT_SECONDS=600
XTTS_GENERATION_TIMEOUT_SECONDS=300
VIDIOLINGUA_VOICE_INTERMEDIATE_DIR=outputs/intermediate
VIDIOLINGUA_XTTS_TEMP=0.65
VIDIOLINGUA_XTTS_REPETITION_PENALTY=10.0

# Optional cloud/legacy TTS
HUME_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# BGM separation: Demucs / UVR-style vocals plus no_vocals split.
VIDIOLINGUA_USE_UVR5=false
VIDIOLINGUA_REQUIRE_UVR5=false
VIDIOLINGUA_DEMUCS_MODEL=htdemucs

# Lip-sync: MuseTalk 1.5 is intended. Wav2Lip is legacy fallback; SadTalker is disabled unless explicitly selected.
VIDIOLINGUA_LIPSYNC_ENGINE=auto
VIDIOLINGUA_MUSETALK_DIR=
VIDIOLINGUA_MUSETALK_CHECKPOINT_DIR=
VIDIOLINGUA_WAV2LIP_DIR=
VIDIOLINGUA_WAV2LIP_CHECKPOINT=
VIDIOLINGUA_SADTALKER_DIR=

# Optional restoration
VIDIOLINGUA_GFPGAN_DIR=
VIDIOLINGUA_GFPGAN_MODEL_PATH=
VIDIOLINGUA_REQUIRE_GFPGAN=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Linguistic and phonetic integrity gates
VIDIOLINGUA_ENABLE_LINGUISTIC_INTEGRITY=true
VIDIOLINGUA_FAIL_ON_LINGUISTIC_ERRORS=true
VIDIOLINGUA_ENABLE_PHONETIC_RESOLUTION=true
VIDIOLINGUA_USE_TTS_PREPARED_TEXT=true
VIDIOLINGUA_PRONUNCIATION_DICTIONARY=config\pronunciation_dictionary.json
# Responsible AI and provenance readiness
VIDIOLINGUA_ENABLE_RESPONSIBLE_AI=true
VIDIOLINGUA_COMPLIANCE_MODE=report_only
VIDIOLINGUA_REQUIRE_SPEAKER_CONSENT=false
VIDIOLINGUA_APPLY_VISIBLE_DISCLOSURE=false
VIDIOLINGUA_APPLY_AUDIO_DISCLOSURE=false
VIDIOLINGUA_EMBED_PROVENANCE_METADATA=true
VIDIOLINGUA_GENERATE_COMPLIANCE_PASSPORT=true
VIDIOLINGUA_BLOCK_HIGH_RISK_SGI=false
VIDIOLINGUA_RETENTION_DAYS=30
